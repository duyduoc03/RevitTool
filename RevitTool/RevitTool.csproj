<Project Sdk="Nice3point.Revit.Sdk/6.1.2">

	<PropertyGroup>	
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<DeployAddin>true</DeployAddin>
		<LaunchRevit>true</LaunchRevit>
		<IsRepackable>false</IsRepackable>
		<EnableDynamicLoading>true</EnableDynamicLoading>
		<Configurations>Debug.R26;Debug.R27</Configurations>
		<Configurations>$(Configurations);Release.R26;Release.R27</Configurations>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release.R27|AnyCPU'">
	  <IsPublishable>True</IsPublishable>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release.R26|AnyCPU'">
	  <IsPublishable>True</IsPublishable>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug.R27|AnyCPU'">
	  <IsPublishable>True</IsPublishable>
	  <Optimize>True</Optimize>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug.R26|AnyCPU'">
	  <IsPublishable>True</IsPublishable>
	  <Optimize>True</Optimize>
	</PropertyGroup>

	<ItemGroup>
		<!-- Revit Dependencies -->
		<PackageReference Include="ClosedXML" Version="0.105.1" />
		<PackageReference Include="Nice3point.Revit.Toolkit" Version="2026.1.0" />
		<PackageReference Include="Nice3point.Revit.Extensions" Version="2026.1.3" />
		<PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2026.4.10" />
		<PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2026.4.10" />

		<!-- MVVM -->
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />

		<!-- Development Dependencies -->
		<PackageReference Include="JetBrains.Annotations" Version="2026.2.0" PrivateAssets="all" />
		<PackageReference Include="Polyfill" Version="11.0.1" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Resources\Icons\RibbonIcon16.png" />
		<Resource Include="Resources\Icons\RibbonIcon32.png" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Properties\Settings.Designer.cs">
	    <DesignTimeSharedInput>True</DesignTimeSharedInput>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>Settings.settings</DependentUpon>
	  </Compile>
	</ItemGroup>

	<ItemGroup>
	  <None Update="Properties\Settings.settings">
	    <Generator>SettingsSingleFileGenerator</Generator>
	    <LastGenOutput>Settings.Designer.cs</LastGenOutput>
	  </None>
	  <None Update="RevitTool.addin">
		<CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </None>
	</ItemGroup>

</Project>